# PORT: Optional server port override (defaults to 3000)

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Security / playback hardening ---
# Owner portal PIN (min 8 chars). If unset, the owner portal stays disabled.
VITE_OWNER_PIN=
# GitHub write token for the owner portal. Never commit a real token.
VITE_GITHUB_WRITE_TOKEN=
# Telethon HTTP range gateway base, e.g. http://localhost:8765
VITE_STREAM_GATEWAY_URL=

# --- Telegram sync (server-side only, never expose to Vite) ---
TG_API_ID=
TG_API_HASH=
TG_STRING_SESSION=
TG_BOT_TOKEN=

# --- Server-side owner panel & media proxy ---
# Password for /api/velora owner authentication. If unset, admin login is disabled.
VELORA_OWNER_PASSWORD=
# Extra comma-separated hosts allowed through /api/media/proxy (download CORS fallback).
MEDIA_PROXY_ALLOWED_HOSTS=

# --- Master Admin Panel (Petros Cinema) ---
# Master password for /admin (min 12 chars). If unset, the panel login stays disabled.
MASTER_ADMIN_PASSWORD=
# GitHub token used by the Live Sync Engine to commit + push data/streams.json.
GITHUB_TOKEN=
# Repository override (defaults to the project repo).
GITHUB_REPO=aipetrosapp-max/Petros-cinama
GITHUB_BRANCH=main
# Admin session lifetime in milliseconds (default 4 hours).
MASTER_ADMIN_SESSION_TTL_MS=14400000
